# HTTPS 리버스 프록시 예시 (Caddy, https://caddyserver.com)
# 1) 도메인을 이 PC/서버의 공인 IP로 연결하고 80·443 포트를 연다.
# 2) 이 파일을 Caddyfile 로 복사해 도메인을 바꾼 뒤  caddy run --config Caddyfile  실행.
#    인증서는 Let's Encrypt 에서 자동 발급·갱신된다.
# 3) 앱은 127.0.0.1:3987 에서만 듣게 두고(.env.prod HOST=127.0.0.1) Caddy 만 외부에 노출한다.

planner.example.com {
    encode gzip
    reverse_proxy 127.0.0.1:3987

    # 아이디·비밀번호 무차별 대입을 줄이기 위한 간단한 요청 제한이 필요하면
    # caddy 의 rate_limit 플러그인(xcaddy 빌드)을 쓰거나 앞단 방화벽에서 제한한다.

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy no-referrer
    }

    log {
        output file /var/log/caddy/planner.log
    }
}

# 학원 내부망에서 IP로만 쓰는 경우 (공인 도메인 없음): 자체 서명 인증서를 Caddy 가 만들어 준다.
# 브라우저 경고가 뜨지만 같은 Wi-Fi 안에서만 쓰면 충분하다.
# :8443 {
#     tls internal
#     reverse_proxy 127.0.0.1:3987
# }

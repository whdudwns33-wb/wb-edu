# 운영 모드 설정 예시. 이 파일을 .env.prod 로 복사해 값을 채우세요. (.env.prod 는 git에 올라가지 않습니다)
# 첫 실행 때만 초기 관리자 계정을 만드는 데 쓰이며, 이후에는 설정 → 내 계정에서 비밀번호를 바꿀 수 있습니다.
WB_ADMIN_USER=admin
WB_ADMIN_PASSWORD=여기에_강한_비밀번호
# 같은 PC에서만 접속하면 127.0.0.1, 학원 내 다른 기기(휴대폰 등)에서도 접속하려면 0.0.0.0
HOST=127.0.0.1
PORT=3987
# 백업 폴더 (기본 server/data/backups)
# WB_BACKUP_DIR=D:/wb-edu-backups
